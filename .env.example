# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
# Local (XAMPP) defaults:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db
DB_PORT=3306
DB_SSL=false

# Hosted MySQL (e.g. TiDB Cloud) — set DB_SSL=true and fill the values below:
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=<prefix>.root
# DB_PASSWORD=<your-password>
# DB_NAME=test
# DB_SSL=true
